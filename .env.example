# Postgres — matches the docker-compose service below
DATABASE_URL="postgresql://rei:rei_dev_password@localhost:5432/rei_crm?schema=public"

# Auth.js
# generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="change-me-in-every-environment"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# How often (seconds) a live session re-reads users.status/role from the database.
# 0 = check on every request. See src/lib/auth/README notes in auth.ts.
SESSION_REVALIDATE_SECONDS="30"

# Invite lifetime in hours
INVITE_TTL_HOURS="72"

# RBAC toggles the plan marks as "configurable"
OUTSIDE_SALES_CAN_CREATE_CONTRACT="false"
OUTSIDE_SALES_CLIENT_REQUIRES_APPROVAL="false"

# Seed (npx prisma db seed)
SEED_SUPER_ADMIN_EMAIL="admin@radx.app"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe123!"
SEED_SUPER_ADMIN_NAME="Rei Super Admin"

# ---- Faza 5 ----
# Njoftimet me email. Pa SMTP_HOST mesazhi shkruhet në log në vend që të dërgohet.
MAIL_FROM="Rei CRM <no-reply@radx.app>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# Sa ditë para skadimit njoftohet pronari i kontratës (seksioni 8)
CONTRACT_EXPIRY_WARNING_DAYS="30"

# Radha pg-boss dhe ora e punëve të natës (UTC). Worker-i është proces i veçantë:
# npm run worker  (ose shërbimi `worker` i docker-compose)
PGBOSS_SCHEMA="pgboss"
NIGHTLY_CRON="15 2 * * *"
JOBS_ENABLED="true"

# ---- Faza 6 ----
# Përmbledhja ditore (pas fshirjes së natës) dhe raporti mujor (më 1) — UTC
DIGEST_CRON="0 6 * * *"
MONTHLY_REPORT_CRON="30 6 1 * *"
